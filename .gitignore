# Python (adapted from github/gitignore/Python.gitignore)
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage*
htmlcov/
.venv/
.env
.env.*
!.env.example
*.log
.DS_Store
.idea/
.vscode/
.claude/settings.local.json

# Local research data and generated artifacts
/data/
/checkpoints/
/runs/
/outputs/
wandb/
mlruns/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.gguf
graphify-out/

# Published artifacts are explicitly opted in; other model files stay ignored.
!/releases/artifacts/**/*.pt
!/releases/artifacts/**/*.pth
!/releases/artifacts/**/*.ckpt
!/releases/artifacts/**/*.safetensors
!/releases/artifacts/**/*.onnx
!/releases/artifacts/**/*.gguf
